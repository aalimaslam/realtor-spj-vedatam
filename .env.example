# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.

# From the Google service account JSON key (client_email field)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the Google service account JSON key (private_key field).
# Keep the literal \n sequences — do not replace them with real newlines.
GOOGLE_PRIVATE_KEY=

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEET_ID=

# Name of the tab/sheet leads should be appended to. Must already exist.
GOOGLE_SHEET_TAB=Sheet1
